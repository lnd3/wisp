# Copy this to .env (gitignored) and fill in real values. Lives at
# <deploy-root>/<environment>/deploy/.env on the server — read by
# docker-compose.yml, and by deploy/configure-nginx.sh (over SSH) —
# nowhere else, deliberately (see that script's header for why there's
# no CLI override).

# wisp's public domain — collector endpoint and (later) dashboard.
# A subdomain of mera.network, which is NS-delegated to EphemNet's own
# ephemnetd, not an ordinary registrar zone: its A record is a
# zones.json entry on bh2 (direct mode, bh2's public IP — same shape as
# status.mera.network/api.mera.network), not a registrar DNS panel.
# See deploy/README.md's one-time setup.
#   live: wisp.mera.network
#   dev:  (pick a dev-only subdomain once a dev environment is needed)
WISP_DOMAIN=

# Dashboard access (https://<WISP_DOMAIN>/dashboard/), enforced by
# wisp-caddy's basic_auth. Both REQUIRED: compose refuses to start
# wisp-caddy without them (fail loud, never silently unauthenticated).
WISP_DASHBOARD_USER=
# A bcrypt hash, never the password itself. Generate with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-real-password' | sed 's/\$/\$\$/g'
# The sed matters. Compose's own .env parser interpolates `$` in every
# value, so an unescaped bcrypt hash ($2a$14$…) is silently mangled and
# every login then fails with no error anywhere. EphemNet found this
# live on 2026-09-30. Every literal `$` must be `$$`.
WISP_DASHBOARD_HASH=

# wisp's own product token: wisp counts its landing page with its own
# hook, as product "wisp", like any other product. Optional (unset = not
# counted). Generate with `openssl rand -hex 32`, and register its hash
# as "wisp" in deploy/products.json (see deploy/README.md).
WISP_TOKEN=

# ---- Second environment (dev), optional ----
#
# A second concurrent environment on the same host needs its own
# <deploy-root>/dev path with its own deploy/.env: a distinct
# WISP_DOMAIN plus non-colliding ports and subnet. Every value below
# defaults to live's own if unset, so live's .env needs none of this.
#
# Live's defaults, for reference (do NOT copy this line):
#   wisp-caddy: 9480 / 9220, subnets 172.27.1.0/24 (edge) and
#   172.27.11.0/24 (internal) — checked LIVE
#   against bh2 2026-09-30, see docker-compose.yml's header.
#
# COPY-PASTE BLOCK — delete the leading "# " from each line, change
# nothing else (no trailing text or inline comment after the value, or
# configure-nginx.sh refuses it rather than silently falling back to
# live's own port — the real incident in cinder's history this avoids):
# WISP_CADDY_HTTPS_PORT=9580
# WISP_CADDY_HTTP_PORT=9320
# WISP_EDGE_SUBNET=172.27.2.0/24
# WISP_INTERNAL_SUBNET=172.27.12.0/24
