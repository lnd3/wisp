# health-wisp's HTTP-01 vhost: plain :80 for HEALTH_DOMAIN goes to
# health-caddy (ACME challenges, then a redirect to https). Same
# logging lockdown as wisp-http01.conf: no access log, error log at
# crit, so no client address persists. Rendered and installed by
# deploy/health/deploy.sh in TLS mode.
server {
	listen 80;
	server_name ${HEALTH_DOMAIN};
	access_log off;
	error_log /var/log/nginx/error.log crit;

	location / {
		proxy_set_header Host $host;
		proxy_pass http://127.0.0.1:${HEALTH_CADDY_HTTP_PORT};
	}
}
